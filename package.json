    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "@hapi/boom": "^10.0.1",
    "better-sqlite3": "^9.2.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.8",
